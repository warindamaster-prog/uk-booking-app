# Public site URL (no trailing slash). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Billing. Leave "false" while testing: every business keeps its free 60-day trial, no card is taken
# and booking pages stay open. Set "true" at launch to close pages whose trial has ended.
BILLING_ENABLED=false
