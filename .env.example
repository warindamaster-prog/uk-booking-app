# Public site URL (no trailing slash). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Billing. Leave "false" while testing: every business keeps its free 60-day trial, no card is taken
# and booking pages stay open. Set "true" at launch to close pages whose trial has ended.
BILLING_ENABLED=false

# Customers' cancellation links are derived from this secret. Use a random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=

# Email. Pick ONE way to send:
# (a) Your own mailbox over SMTP (simple; fine for testing and small volumes). With Gmail, turn on
#     2-step verification and create an "app password"; use smtp.gmail.com, port 587.
#     EMAIL_FROM must be the same address as SMTP_USER.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# (b) Resend (better delivery at volume; needs a verified domain). Use instead of the SMTP lines:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=
#   EMAIL_FROM=bookings@your-domain.com
#
# While testing, send EVERY email to this one address instead of real customers:
EMAIL_OVERRIDE_TO=

# Protects the reminder job. Random string of 16+ characters; the scheduler sends it as a Bearer token.
CRON_SECRET=
