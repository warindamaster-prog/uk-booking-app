# Public site URL (no trailing slash). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Billing. Leave "false" while testing: every business keeps its free 60-day trial, no card is taken
# and booking pages stay open. Set "true" at launch to close pages whose trial has ended.
BILLING_ENABLED=false

# Customers' cancellation links are derived from this secret. Use a random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=

# Email. Pick ONE way to send:
# (a) Your own mailbox over SMTP (simple; fine for testing and small volumes). With Gmail, turn on
#     2-step verification and create an "app password"; use smtp.gmail.com, port 587.
#     EMAIL_FROM must be the same address as SMTP_USER.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# (b) Resend (better delivery at volume; needs a verified domain). Use instead of the SMTP lines:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=
#   EMAIL_FROM=bookings@your-domain.com
#
# Optional: send the "you have a new booking" alerts to the SHOP from a different mailbox
# (for example a Sales mailbox). Leave all NOTIFY_ lines empty to use the mailbox above for everything.
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_FROM_NAME=Booking alerts
#
# Lets shops send customers' emails from their own mailbox (Settings > Email sending). Their password
# is encrypted with this key before it is stored. 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_CREDENTIALS_KEY=
#
# While testing, send EVERY email to this one address instead of real customers:
EMAIL_OVERRIDE_TO=

# Protects the reminder job. Random string of 16+ characters; the scheduler sends it as a Bearer token.
CRON_SECRET=

# Stripe (card payments). Optional: without these the app works and deposits are unavailable.
# Use TEST mode keys while testing (sk_test_..., ca_... from the test-mode Connect settings).
STRIPE_SECRET_KEY=
# Customer deposits are paid to each shop's OWN Stripe account via Stripe Connect (Standard).
# Dashboard > Connect > Settings > OAuth: turn on OAuth for Standard accounts, add the redirect URI
#   <your site>/api/stripe/connect/callback   and copy the "client ID" (starts with ca_).
STRIPE_CONNECT_CLIENT_ID=
# Webhooks: add ONE endpoint, <your site>/api/stripe/webhook.
#  - "Connected accounts" events: checkout.session.completed, checkout.session.async_payment_succeeded,
#    account.updated, account.application.deauthorized  -> its signing secret goes here:
STRIPE_CONNECT_WEBHOOK_SECRET=
#  - "Your account" events: customer.subscription.created, customer.subscription.updated,
#    customer.subscription.deleted, checkout.session.completed -> its signing secret goes here.
#    (Stripe uses a separate endpoint entry for each kind; both point at the same URL.)
STRIPE_WEBHOOK_SECRET=
# The shops' subscription prices and the 20% VAT rate. Create them once with:  npm run stripe:setup
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_VAT_TAX_RATE_ID=
